{
  "name": "alter-ego-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "dev": "node --watch --env-file-if-exists=.env.local server.mjs",
    "test": "node --test",
    "check": "node --check server.mjs && node --check lib/assistant.mjs && node --check public/app.js && node --check scripts/install-model.mjs && node --check scripts/model-service.mjs",
    "model:install": "node scripts/install-model.mjs",
    "model:start": "node scripts/model-service.mjs start",
    "model:stop": "node scripts/model-service.mjs stop"
  }
}
