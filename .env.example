# Copier vers .env.local ; ne jamais publier un vrai mot de passe.
# Moteur installé sur la même machine (aucune clé d’API d’IA nécessaire).
MODEL_URL=http://127.0.0.1:8081
# Au moins 12 caractères ; l’application reste verrouillée sans cette valeur.
ASSISTANT_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Journal privé persistant ; ce dossier ne doit jamais être publié dans Git.
# CALORIES_DATA_DIR=/chemin/vers/un/volume/prive
# Pour un accès distant, proxy HTTPS et URL exacte obligatoires :
# PUBLIC_ORIGIN=https://assistant.example.invalid
